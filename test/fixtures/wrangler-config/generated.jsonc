// Generated by scripts/wrangler-config.mjs from wrangler.example.jsonc; edit the inputs, not this file.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-inbox-second",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_request_signal"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/agent/*",
      "/hooks/*"
    ]
  },
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-inbox",
      "database_id": "11111111-2222-4333-8444-555555555555",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "team.cloudflareaccess.com",
    "ACCESS_AUD": "abababababababababababababababababababababababababababababababab",
    "PUBLIC_URL": "https://agent-inbox.example.workers.dev",
    "CHANGES_RETENTION_DAYS": "60"
  },
  "triggers": {
    "crons": [
      "17 4 * * *"
    ]
  },
  "observability": {
    "enabled": true
  }
}
